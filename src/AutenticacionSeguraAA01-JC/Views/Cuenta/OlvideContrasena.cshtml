@model AutenticacionSeguraAA01_JC.ViewModels.OlvideContrasenaViewModel

@{
    Layout = "_LayoutCuenta";
    ViewData["Title"] = "Recuperar contraseña";
}

<section id="recuperar" class="login-page py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5">
                <div class="login-panel">
                    <h1 class="section-title text-center mb-4">Recuperar contraseña</h1>

                    <form asp-action="OlvideContrasena" method="post" class="login-form card shadow-sm p-4" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <p class="text-muted">Escribe el correo de tu cuenta y te enviaremos un enlace para crear una nueva contraseña.</p>

                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label">Correo electrónico</label>
                            <input asp-for="Correo" class="form-control" autocomplete="email" placeholder="Ej: correo@ejemplo.com" />
                            <span asp-validation-for="Correo" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-accent w-100">
                            <i class="bi bi-envelope"></i> Enviar enlace
                        </button>
                    </form>

                    <p class="text-center mt-3 mb-0">
                        <a asp-action="IniciarSesion"><i class="bi bi-arrow-left"></i> Volver a iniciar sesión</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>