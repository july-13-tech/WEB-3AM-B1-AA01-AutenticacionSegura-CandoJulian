@model AutenticacionSeguraAA01_JC.ViewModels.RegistroViewModel

@{
    Layout = "_LayoutCuenta";
    ViewData["Title"] = "Crear cuenta";
}

<section id="registro" class="login-page py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5">
                <div class="login-panel">
                    <h1 class="section-title text-center mb-4">Crear cuenta</h1>

                    <form asp-action="Registrar" method="post" class="login-form card shadow-sm p-4" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="NombreCompleto" class="form-label">Nombre completo</label>
                            <input asp-for="NombreCompleto" class="form-control" autocomplete="name" placeholder="Ej: Julián Cando" />
                            <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label">Correo electrónico</label>
                            <input asp-for="Correo" class="form-control" autocomplete="email" placeholder="Ej: correo@ejemplo.com" />
                            <span asp-validation-for="Correo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Contrasena" class="form-label">Contraseña</label>
                            <div class="input-group">
                                <input asp-for="Contrasena" class="form-control" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary" data-alternar-contrasena="Contrasena" aria-label="Mostrar u ocultar contraseña">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Contrasena" class="text-danger small"></span>
                            <div class="form-text">Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmarContrasena" class="form-label">Confirmar contraseña</label>
                            <div class="input-group">
                                <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary" data-alternar-contrasena="ConfirmarContrasena" aria-label="Mostrar u ocultar contraseña">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-accent w-100">
                            <i class="bi bi-person-plus"></i> Crear cuenta
                        </button>
                    </form>

                    <p class="text-center mt-3 mb-0">
                        ¿Ya tienes cuenta?
                        <a asp-action="IniciarSesion">Inicia sesión</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>