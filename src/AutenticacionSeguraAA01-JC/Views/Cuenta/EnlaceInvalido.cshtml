@{
    Layout = "_LayoutCuenta";
    ViewData["Title"] = "Enlace no válido";
}

<section id="enlace-invalido" class="login-page py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5">
                <div class="login-panel text-center">
                    <i class="bi bi-exclamation-triangle icono-acento"></i>
                    <h1 class="h3 mt-3">Enlace no válido</h1>
                    <p class="text-muted">El enlace no es válido, ya fue utilizado o ha vencido.</p>
                    <a asp-action="OlvideContrasena" class="btn btn-accent">
                        <i class="bi bi-envelope"></i> Solicitar un enlace nuevo
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>