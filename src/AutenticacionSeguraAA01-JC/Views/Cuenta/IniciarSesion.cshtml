@model AutenticacionSeguraAA01_JC.ViewModels.IngresoViewModel

@{
    Layout = "_LayoutCuenta";
    ViewData["Title"] = "Inicio de sesión";
}

<section id="login" class="login-page py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5">
                <div class="login-panel">
                    <h1 class="section-title text-center mb-4">Inicio de sesión</h1>

                    <form asp-action="IniciarSesion" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="login-form card shadow-sm p-4" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label">Correo electrónico</label>
                            <input asp-for="Correo" class="form-control" autocomplete="username" placeholder="Ej: correo@ejemplo.com" />
                            <span asp-validation-for="Correo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Contrasena" class="form-label">Contraseña</label>
                            <div class="input-group">
                                <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                                <button type="button" class="btn btn-outline-secondary" data-alternar-contrasena="Contrasena" aria-label="Mostrar u ocultar contraseña">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Contrasena" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="form-check mb-0">
                                <input asp-for="Recordarme" class="form-check-input" />
                                <label asp-for="Recordarme" class="form-check-label">Recordarme</label>
                            </div>
                            <a asp-action="OlvideContrasena" class="small">¿Olvidaste tu contraseña?</a>
                        </div>

                        <button type="submit" class="btn btn-accent w-100">
                            <i class="bi bi-box-arrow-in-right"></i> Ingresar
                        </button>
                    </form>

                    <p class="text-center mt-3 mb-0">
                        ¿No tienes cuenta?
                        <a asp-action="Registrar">Crear cuenta</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @if (TempData["Mensaje"] is string mensaje)
    {
        <script>
            Swal.fire({ icon: 'success', title: 'Listo', text: @Json.Serialize(mensaje), confirmButtonText: 'Aceptar' });
        </script>
    }
}