@model AutenticacionSeguraAA01_JC.ViewModels.PerfilViewModel

@{
    ViewData["Title"] = "Mi perfil";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="section-title text-center h3 mb-4">Mi perfil</h1>

        <div class="card card-mundo">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-4">
                    <i class="bi bi-person-circle icono-acento me-3"></i>
                    <div>
                        <h2 class="h5 mb-1">@Model.NombreCompleto</h2>
                        <span class="text-muted">@Model.Correo</span>
                    </div>
                </div>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Nombre completo</dt>
                    <dd class="col-sm-8">@Model.NombreCompleto</dd>

                    <dt class="col-sm-4">Correo</dt>
                    <dd class="col-sm-8">@Model.Correo</dd>

                    <dt class="col-sm-4">Rol</dt>
                    <dd class="col-sm-8">
                        @if (Model.Rol == "Administrador")
                        {
                            <span class="badge badge-oscuro">@Model.Rol</span>
                        }
                        else
                        {
                            <span class="badge badge-accent">@Model.Rol</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Estado de la cuenta</dt>
                    <dd class="col-sm-8">
                        @if (Model.Habilitado)
                        {
                            <span class="badge text-bg-success">Activa</span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger">Deshabilitada</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Miembro desde</dt>
                    <dd class="col-sm-8">@Model.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>

                <a asp-action="CambiarContrasena" class="btn btn-accent">
                    <i class="bi bi-key"></i> Cambiar contraseña
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (TempData["Mensaje"] is string mensaje)
    {
        <script>
            Swal.fire({ icon: 'success', title: 'Listo', text: @Json.Serialize(mensaje), confirmButtonText: 'Aceptar' });
        </script>
    }
}