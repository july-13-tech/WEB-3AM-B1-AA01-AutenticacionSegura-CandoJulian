@using AutenticacionSeguraAA01_JC.Comunes.Constantes
@model List<AutenticacionSeguraAA01_JC.ViewModels.UsuarioListadoViewModel>

@{
    ViewData["Title"] = "Administración de usuarios";
}

<h1 class="section-title text-center h3 mb-4">Administración de usuarios</h1>

<div class="card card-mundo">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-mundo align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Registro</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuarioListadoViewModel in Model)
                    {
                        <tr>
                            <td>
                                @usuarioListadoViewModel.NombreCompleto
                                @if (usuarioListadoViewModel.EsUsuarioActual)
                                {
                                    <span class="badge badge-oscuro ms-1">Tú</span>
                                }
                            </td>
                            <td>@usuarioListadoViewModel.Correo</td>
                            <td>
                                <form asp-action="CambiarRol" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="IdUsuario" value="@usuarioListadoViewModel.IdUsuario" />
                                    <select name="NuevoRol" class="form-select form-select-sm" aria-label="Rol">
                                        @foreach (var nombreRol in ConstantesNombresRoles.TODOS)
                                        {
                                            <option value="@nombreRol" selected="@(nombreRol == usuarioListadoViewModel.Rol)">@nombreRol</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-outline-accent btn-sm">Guardar</button>
                                </form>
                            </td>
                            <td>
                                @if (usuarioListadoViewModel.Habilitado)
                                {
                                    <span class="badge text-bg-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">Deshabilitada</span>
                                }
                            </td>
                            <td>@usuarioListadoViewModel.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                @if (usuarioListadoViewModel.Habilitado)
                                {
                                    <form asp-action="CambiarEstado" method="post" class="d-inline" data-confirmar="Se deshabilitará la cuenta de @usuarioListadoViewModel.Correo y se cerrará su sesión. ¿Deseas continuar?">
                                        <input type="hidden" name="IdUsuario" value="@usuarioListadoViewModel.IdUsuario" />
                                        <input type="hidden" name="Habilitar" value="false" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-person-x"></i> Deshabilitar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="CambiarEstado" method="post" class="d-inline">
                                        <input type="hidden" name="IdUsuario" value="@usuarioListadoViewModel.IdUsuario" />
                                        <input type="hidden" name="Habilitar" value="true" />
                                        <button type="submit" class="btn btn-outline-success btn-sm">
                                            <i class="bi bi-person-check"></i> Habilitar
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/administracion.js" asp-append-version="true"></script>
    @if (TempData["Mensaje"] is string mensaje)
    {
        <script>
            Swal.fire({ icon: 'success', title: 'Listo', text: @Json.Serialize(mensaje), confirmButtonText: 'Aceptar' });
        </script>
    }
    @if (TempData["Error"] is string error)
    {
        <script>
            Swal.fire({ icon: 'error', title: 'No se pudo completar', text: @Json.Serialize(error), confirmButtonText: 'Aceptar' });
        </script>
    }
}